# PostgreSQL container credentials
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# postgresql://POSTGRES_USER:POSTGRES_PASSWORD@postgres:5432/POSTGRES_DB?schema=public
# Use host "postgres" inside Docker Compose and "localhost" for local development.
DATABASE_URL=

# Long random strings, different for access and refresh, for example: openssl rand -hex 48
# Access token lives 15 minutes, refresh token (httpOnly cookie) 7 days.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# true on a public server behind https (Secure cookie, HSTS, see Deploy in README); false for http://localhost
HTTPS_ENABLED=

# Demo admin created by the seed (role ADMIN); the password is hashed on every seed run
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Address of the API for server-side requests from the web container, without /api.
# Inside Docker Compose: http://api:4000. For `pnpm --filter web dev`: http://localhost:4000
API_INTERNAL_URL=

# IANA time zone used for demo dates in the seed and for server logs, for example UTC
TZ=

# Local development only (not used by the containers)
# Host port for PostgreSQL from docker-compose.dev.yml, default 5432
POSTGRES_DEV_PORT=
# `pnpm --filter api test` needs none of this, it starts its own PostgreSQL.
# Only for `pnpm --filter api test:run` against a database you run yourself; the name must end with _test,
# for example postgresql://POSTGRES_USER:POSTGRES_PASSWORD@localhost:5432/aurora_test?schema=public
TEST_DATABASE_URL=
